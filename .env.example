# clabhost settings. Copy to .env; install.sh writes one for you.

# ── Access ────────────────────────────────────────────────────────────────────
# Server address, used in the messages install.sh prints.
HOST_IP=

# The only port published to the outside. Plain HTTP -- narrow the source range
# with ufw. See docs/firewall.ko.md.
HTTP_PORT=80

# clab-api-server, installed natively on the host.
CLAB_API_URL=http://127.0.0.1:8090

# What `install.sh check` should probe. Leave empty for the default,
# http://127.0.0.1:$HTTP_PORT. Set it if you moved the site behind TLS -- plain
# HTTP then answers 308 and the check would report a failure that is not one.
#   SITE_URL=https://clab1.example.net
SITE_URL=

# ── Account ───────────────────────────────────────────────────────────────────
# The account the editor runs as and whose labs it opens. clabhost is a
# single-user host: anyone who signs in reaches this one workspace.
CLAB_USER=
CLAB_HOME=
CLAB_UID=
CLAB_GID=

# Host group ids, resolved by install.sh. The editor container joins both:
# docker for the socket, clab_admins because containerlab checks it.
DOCKER_GID=
CLAB_ADMINS_GID=

# Host binaries mounted into the editor. containerlab is always /usr/bin;
# docker moves depending on how it was installed.
DOCKER_BIN=/usr/bin/docker

# ── Paths ─────────────────────────────────────────────────────────────────────
# Everything durable, as plain directories rather than named volumes:
#
#   $DATA_DIR/caddy/{data,config}          ACME account key and certificates
#   $DATA_DIR/grafana                      dashboards you created, users, prefs
#   $DATA_DIR/prometheus                   the metric store
#   $DATA_DIR/code-server/{extensions,user-data}
#
# Point this at another disk if the metric store or the extensions outgrow this
# one -- PROM_MAX_SIZE below plus a `full` extension set is most of the volume.
# Back up with `tar czf backup.tgz -C /opt/clabhost data`. Note that
# `docker compose down -v` no longer removes any of it; `rm -rf` does.
DATA_DIR=/opt/clabhost/data

# Unix sockets: the editor's and Grafana's. Must be on a tmpfs -- install.sh
# adds a tmpfiles.d entry so it comes back with the right owners after a boot.
SOCKET_DIR=/run/clabhost

# ── Editor ────────────────────────────────────────────────────────────────────
# code-server is installed on the host, not run as a container -- its terminal
# has to be the host's. There is no image tag to pin here; install.sh uses the
# official installer. See docs/install.ko.md.
#
# Extension set to pre-install: minimal | network | full
# full includes the LLM assistants and is close to 1 GB.
EXT_SET=full

# ── Monitoring ────────────────────────────────────────────────────────────────
PROM_RETENTION=30d
PROM_MAX_SIZE=8GB

# ── Internal network ──────────────────────────────────────────────────────────
# Pinned so Docker's automatic allocation cannot land on containerlab's default
# management range. See docs/addressing.ko.md.
INTERNAL_SUBNET=172.30.255.0/24

# ── Images ────────────────────────────────────────────────────────────────────
# Pin these in production. containerlab-web keeps sessions in memory, so a
# restart signs everyone out.
IMG_CADDY=caddy:2-alpine
IMG_WEB=ghcr.io/srl-labs/containerlab-web:latest
IMG_PYTHON=python:3-alpine
IMG_GRAFANA=grafana/grafana:13.0.1
IMG_PROMETHEUS=quay.io/prometheus/prometheus:v3.11.3
IMG_NODE_EXPORTER=quay.io/prometheus/node-exporter:v1.12.1
IMG_CADVISOR=gcr.io/cadvisor/cadvisor:v0.55.1
